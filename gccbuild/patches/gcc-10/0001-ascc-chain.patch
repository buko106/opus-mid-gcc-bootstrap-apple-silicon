diff --git a/gcc/config/darwin.h b/gcc/config/darwin.h
index 9411b05c5..1668fa7c0 100644
--- a/gcc/config/darwin.h
+++ b/gcc/config/darwin.h
@@ -429,7 +429,10 @@ extern GTY(()) int darwin_ms_struct;
       }}}\
    }}}}}}}}"
 
-#define LINK_COMMAND_SPEC LINK_COMMAND_SPEC_A DSYMUTIL_SPEC
+/* ascc bootstrap chain: dsymutil belongs to the macOS toolchain, which may
+   not be used to produce artifacts, so never ask collect2 to run it.  The
+   DWARF stays in the object files (where debuggers can still find it).  */
+#define LINK_COMMAND_SPEC LINK_COMMAND_SPEC_A
 
 /* Tell collect2 to run dsymutil for us as necessary.  */
 #define COLLECT_RUN_DSYMUTIL 1
diff --git a/libgcc/config/aarch64/lse.S b/libgcc/config/aarch64/lse.S
index 2c6f7db6e..1be014c2c 100644
--- a/libgcc/config/aarch64/lse.S
+++ b/libgcc/config/aarch64/lse.S
@@ -61,7 +61,11 @@ see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
 #if __ELF__
 	.hidden	__aarch64_have_lse_atomics
 #else
-	.private_extern	__aarch64_have_lse_atomics
+/* ascc bootstrap chain: Mach-O symbols carry a leading underscore, so the
+   C variable is ___aarch64_have_lse_atomics (as JUMP_IF_NOT_LSE below
+   uses).  The unprefixed name left an undefined symbol in every object,
+   which a linker that resolves all undefined symbols rejects.  */
+	.private_extern	___aarch64_have_lse_atomics
 #endif
 
 /* Turn size and memory model defines into mnemonic fragments.  */
@@ -197,8 +201,12 @@ see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
 	.text
 	.balign	16
 	.private_extern	_\name
-	.cfi_startproc
+/* ascc bootstrap chain: define the label before .cfi_startproc.  Mach-O
+   assemblers (LLVM's and ascc's) reject non-private labels inside a CFI
+   frame ("non-private labels cannot appear between .cfi_startproc /
+   .cfi_endproc pairs"); the frame still starts at the function.  */
 _\name:
+	.cfi_startproc
 	BTI_C
 .endm
 
diff --git a/libgcc/config/aarch64/t-darwin b/libgcc/config/aarch64/t-darwin
index f6ecda7b6..c18408f85 100644
--- a/libgcc/config/aarch64/t-darwin
+++ b/libgcc/config/aarch64/t-darwin
@@ -5,3 +5,10 @@ HOST_LIBGCC2_CFLAGS += -mmacosx-version-min=11.0
 LIB2_SIDITI_CONV_FUNCS = yes
 
 BUILD_LIBGCCS1 =
+
+# ascc bootstrap chain (--disable-shared, so LIB2ADDEH goes into libgcc.a):
+# unwind-dw2-fde-darwin.c finds FDEs through keymgr, which modern macOS no
+# longer has, so a static libgcc would shadow libSystem's working unwinder
+# (libunwind reads __eh_frame directly).  Keep only the C personality
+# routine; Makefile.in appends emutls.c.
+LIB2ADDEH = $(srcdir)/unwind-c.c
diff --git a/libgcc/config/t-darwin b/libgcc/config/t-darwin
index a3bb70c6a..f813e518a 100644
--- a/libgcc/config/t-darwin
+++ b/libgcc/config/t-darwin
@@ -20,9 +20,17 @@ emutls_s.o: HOST_LIBGCC2_CFLAGS += \
 
 # Make the emutls crt as a convenience lib so that it can be linked
 # optionally, use the shared version so that we can link with DSO.
+ifeq ($(enable_shared),yes)
 libemutls_w.a: emutls_s.o
 	$(AR_CREATE_FOR_TARGET) $@ $<
 	$(RANLIB_FOR_TARGET) $@
+else
+# ascc bootstrap chain (--disable-shared): there are no _s objects, so use
+# the static emutls.o, which is weak (see above) like emutls_s.o.
+libemutls_w.a: emutls.o
+	$(AR_CREATE_FOR_TARGET) $@ $<
+	$(RANLIB_FOR_TARGET) $@
+endif
 
 # Patch to __Unwind_Find_Enclosing_Function for Darwin10.
 # This needs to be built for darwin10, regardless of the current platform
