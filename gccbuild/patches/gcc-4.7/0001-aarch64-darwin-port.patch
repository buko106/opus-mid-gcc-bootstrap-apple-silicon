+   <http://www.gnu.org/licenses/>.  */
+
+#undef TARGET_MACHO
+#define TARGET_MACHO 1
+
+#define DARWIN_ARM64 1
+
+/* Used by the common Darwin code.  */
+#undef TARGET_64BIT
+#define TARGET_64BIT 1
+
+/* Darwin arm64 ABI differences from AAPCS64:
+   - plain char is signed;
+   - long double is the same as double;
+   - x18 is reserved for the platform;
+   - variadic arguments are always passed on the stack (8-byte slots);
+   - callers extend char/short arguments to 32 bits.  */
+#undef DEFAULT_SIGNED_CHAR
+#define DEFAULT_SIGNED_CHAR 1
+
+#undef LONG_DOUBLE_TYPE_SIZE
+#define LONG_DOUBLE_TYPE_SIZE 64
+#undef LIBGCC2_LONG_DOUBLE_TYPE_SIZE
+#define LIBGCC2_LONG_DOUBLE_TYPE_SIZE 64
+
+#undef WCHAR_TYPE
+#define WCHAR_TYPE "int"
+#undef WCHAR_TYPE_SIZE
+#define WCHAR_TYPE_SIZE 32
+
+#undef PTRDIFF_TYPE
+#define PTRDIFF_TYPE "long int"
+#undef SIZE_TYPE
+#define SIZE_TYPE "long unsigned int"
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()		\
+  do {						\
+    builtin_define ("__arm64__");		\
+    builtin_define ("__arm64");			\
+    builtin_define ("__LITTLE_ENDIAN__");	\
+    builtin_define ("__LP64__");		\
+    darwin_cpp_builtins (pfile);		\
+  } while (0)
+
+#define DARWIN_ARCH_SPEC "arm64"
+#define DARWIN_SUBARCH_SPEC DARWIN_ARCH_SPEC
+#undef DARWIN_MINVERSION_SPEC
+#define DARWIN_MINVERSION_SPEC "11.0"
+
+#undef SUBTARGET_EXTRA_SPECS
+#define SUBTARGET_EXTRA_SPECS					\
+  DARWIN_EXTRA_SPECS						\
+  { "darwin_arch", DARWIN_ARCH_SPEC },				\
+  { "darwin_crt2", "" },					\
+  { "darwin_subarch", DARWIN_SUBARCH_SPEC },
+
+/* aarch64.h has no EXTRA_SPECS of its own.  */
+#undef EXTRA_SPECS
+#define EXTRA_SPECS SUBTARGET_EXTRA_SPECS
+
+#undef ASM_SPEC
+#define ASM_SPEC "-arch arm64"
+
+/* No crt1.o: the executable uses LC_MAIN.  */
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC ""
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC ""
+
+/* Only static libgcc is built.  */
+#undef REAL_LIBGCC_SPEC
+#define REAL_LIBGCC_SPEC "-lgcc"
+
+/* Never run dsymutil.  */
+#undef LINK_COMMAND_SPEC
+#define LINK_COMMAND_SPEC LINK_COMMAND_SPEC_A
+
+#undef ASM_COMMENT_START
+#define ASM_COMMENT_START "//"
+
+#undef LOCAL_LABEL_PREFIX
+#define LOCAL_LABEL_PREFIX "L"
+#undef REGISTER_PREFIX
+#define REGISTER_PREFIX ""
+
+#undef USER_LABEL_PREFIX
+#define USER_LABEL_PREFIX "_"
+
+#undef ASM_OUTPUT_ALIGN
+#define ASM_OUTPUT_ALIGN(FILE, LOG)			\
+  do {							\
+    if ((LOG) != 0)					\
+      fprintf ((FILE), "\t.p2align\t%d\n", (int) (LOG));	\
+  } while (0)
+
+/* Mach-O has no .size/.type; darwin.h handles labels.  */
+#undef ASM_DECLARE_FUNCTION_SIZE
+
+#undef ASM_OUTPUT_SKIP
+#define ASM_OUTPUT_SKIP(FILE, SIZE) \
+  fprintf ((FILE), "\t.space\t" HOST_WIDE_INT_PRINT_UNSIGNED "\n", \
+	   (unsigned HOST_WIDE_INT) (SIZE))
+
+#undef GOT_SYMBOL_NAME
+#define GOT_SYMBOL_NAME "__GLOBAL_OFFSET_TABLE_"
+
+/* DWARF register numbering is the standard AArch64 one.  */
+#undef DBX_REGISTER_NUMBER
+#define DBX_REGISTER_NUMBER(REGNO) aarch64_dbx_register_number (REGNO)
+
+#undef PREFERRED_DEBUGGING_TYPE
+#define PREFERRED_DEBUGGING_TYPE DWARF2_DEBUG
+
+/* Keep frame records: the system unwinder and debuggers walk x29.  */
+#undef SUBTARGET_OVERRIDE_OPTIONS
+#define SUBTARGET_OVERRIDE_OPTIONS do { } while (0)
+
+#undef TARGET_ASM_FILE_END
+#define TARGET_ASM_FILE_END darwin_file_end
+
+#undef MAX_BITS_PER_WORD
+#define MAX_BITS_PER_WORD 64
+
+/* Indirect pc-relative EH references (personality routines, C++ type
+   info) go through the GOT: ".long _sym@GOT-." is an
+   ARM64_RELOC_POINTER_TO_GOT.  The generic Darwin $non_lazy_ptr scheme
+   cannot be expressed on arm64 (the pointer lives in a section that is not
+   atomized by symbols).  */
+#undef ASM_MAYBE_OUTPUT_ENCODED_ADDR_RTX
+#define ASM_MAYBE_OUTPUT_ENCODED_ADDR_RTX(FILE, ENCODING, SIZE, ADDR, DONE) \
+  if ((SIZE) == 4 && ((ENCODING) & DW_EH_PE_indirect)			\
+      && ((ENCODING) & 0x70) == DW_EH_PE_pcrel				\
+      && GET_CODE (ADDR) == SYMBOL_REF)					\
+    {									\
+      fputs ("\t.long\t", FILE);					\
+      assemble_name (FILE, XSTR (ADDR, 0));				\
+      fputs ("@GOT-.", FILE);						\
+      goto DONE;							\
+    }
