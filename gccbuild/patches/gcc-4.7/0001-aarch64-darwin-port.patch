+  /* macOS 11 and later (needed for arm64): "MM.mm[.pp]" is encoded in
+     the six-digit form MMmmpp, as the system headers expect.  */
+  if (ISDIGIT (darwin_macosx_version_min[0])
+      && ISDIGIT (darwin_macosx_version_min[1])
+      && darwin_macosx_version_min[2] == '.'
+      && strncmp (darwin_macosx_version_min, "10.", 3) != 0)
+    {
+      const char *p = darwin_macosx_version_min;
+      int maj = 0, min = 0, pat = 0;
+      maj = (p[0] - '0') * 10 + (p[1] - '0');
+      p += 3;
+      if (!ISDIGIT (*p))
+	goto fail;
+      while (ISDIGIT (*p))
+	min = min * 10 + (*p++ - '0');
+      if (*p == '.')
+	{
+	  p++;
+	  while (ISDIGIT (*p))
+	    pat = pat * 10 + (*p++ - '0');
+	}
+      if (*p != '\0' || min > 99 || pat > 99)
+	goto fail;
+      sprintf (result6, "%02d%02d%02d", maj, min, pat);
+      return result6;
